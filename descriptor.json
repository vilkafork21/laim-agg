{
  "id": "a065ae89-2a15-4eec-9bdf-700025244166",
  "name": "laim-agg",
  "description": "Агрегатор результатов тестов по блоку — выставляет итоговый светофор",
  "fullDescription": "FOR MORE DETAILS VIEW README.md\n\nО ноде: Агрегатор валидирует all_results тестов (km-dynamic, local/global-drift, oos-oot), точность автоассессора и assessment_result, читает готовность данных конвертера (6.3.2) и провенанс выборки, собирает всё в monitoring-result/v3 и выставляет итог по таблице 15 методики этапа 4: красный только от km_test при допущенном автоассессоре, отсутствие или не оценено ожидаемого теста даёт жёлтый со статусом «не оценено», информативные тесты (покрытие, прогноз, различимость без эталона стабильного периода) в цвет не входят.",
  "shortNameToDisplay": "Светофор",
  "moduleType": "test",
  "shape": "test",
  "uiResults": {
    "semaphore": {
      "port": "all_results",
      "dataKey": "color"
    }
  },
  "ports": [
    {
      "name": "assessor_accuracy",
      "label": "Точность автоассесора",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": true,
      "description": "acc_auto из laim-asessor-agent: число 0..1 или null при status=not_computable",
      "order": 1
    },
    {
      "name": "assessment_result",
      "label": "Статус оценивания",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": true,
      "description": "laim-assessment-result.v1 из laim-asessor-agent",
      "order": 2
    },
    {
      "name": "processing_report",
      "label": "Отчёт конвертера",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": false,
      "description": "processing_report из laim-traces-dataset-converter: блок data_readiness — базовый тест 6.3.2",
      "order": 3
    },
    {
      "name": "sample_meta",
      "label": "Провенанс выборки",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": false,
      "description": "sample_meta из laim-extract-sample: население и отобранные единицы, доля, seed",
      "order": 4
    },
    {
      "name": "in",
      "label": "входные данные",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": false,
      "dynamic": true,
      "description": "Результаты тестов с семафором (km, drift, oos-oot)",
      "order": 5
    },
    {
      "name": "all_results",
      "label": "all_results",
      "in": false,
      "type": "default",
      "shape": "shape_model",
      "description": "monitoring-result/v3: итог по таблице 15 методики, статус оценки качества, реестр тестов (включая пригодность данных 6.3.2) и провенанс выборки",
      "order": 6
    }
  ],
  "portsMetadata": {
    "hasDynamicInputPort": true,
    "hasDynamicOutputPort": false
  },
  "script": {
    "type": "python",
    "deployType": "docker",
    "baseImageKey": "py312-simple",
    "runConfiguration": {
      "libraryDependencies": [
        "requirements.txt"
      ],
      "sourceFiles": [
        "main.py",
        "table15.py"
      ],
      "functionName": "main",
      "functionParameters": []
    }
  },
  "ui": {
    "settings": [
      {
        "page": "General",
        "title": "General",
        "components": [
          {
            "type": "form",
            "label": "Реестр тестов и допуск автоассессора",
            "config": {
              "components": [
                {
                  "parameter": "expected_tests",
                  "label": "Ожидаемые тесты (через запятую)",
                  "uiComponent": "input",
                  "type": "string",
                  "defaultValue": "km_test,local_drift,global_drift,oos_oot"
                },
                {
                  "parameter": "informative_tests",
                  "label": "Информативные тесты (не входят в светофор)",
                  "uiComponent": "input",
                  "type": "string",
                  "defaultValue": "local_drift,global_drift,oos_oot"
                },
                {
                  "parameter": "red_assessor_accuracy",
                  "label": "Минимальная точность автоассессора",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.6
                }
              ]
            }
          }
        ]
      }
    ],
    "result": {
      "title": "Results",
      "components": [
        {
          "type": "semaphore",
          "label": "Итоговый светофор мониторинга",
          "order": 1,
          "config": {
            "datasets": [
              {
                "value": "$.all_results.calculated_traffic_lights.test_light",
                "title": "$.all_results.calculated_traffic_lights.semaphore_title"
              }
            ]
          },
          "showOnWorkflow": true
        },
        {
          "type": "html",
          "uiComponent": "html",
          "name": "$.all_results.report_html",
          "parameter": "$.all_results.report_html",
          "label": "Сводка агрегации",
          "order": 2,
          "config": {
            "datasets": [
              {
                "data": "$.all_results.report_html"
              }
            ]
          }
        }
      ]
    }
  }
}
