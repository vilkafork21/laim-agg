{
  "id": "a065ae89-2a15-4eec-9bdf-700025244166",
  "name": "laim-agg",
  "description": "Агрегатор результатов тестов по блоку — выставляет итоговый светофор",
  "fullDescription": "FOR MORE DETAILS VIEW README.md\n\nО ноде: Агрегатор валидирует all_results четырёх тестов (km-dynamic, local/global-drift, oos-oot), точность автоассесора и assessment_result, собирает их в единый monitoring-result/v2 и выставляет итоговый цвет. Неполный реестр, невычислимый assessment_result или невычислимая ключевая метрика не могут дать зелёный итог.",
  "shortNameToDisplay": "Светофор",
  "moduleType": "test",
  "shape": "test",
  "uiResults": {
    "semaphore": {
      "port": "all_results",
      "dataKey": "color"
    }
  },
  "ports": [
    {
      "name": "assessor_accuracy",
      "label": "Точность автоассесора",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": true,
      "description": "acc_auto из laim-asessor-agent: число 0..1 или null при status=not_computable",
      "order": 1
    },
    {
      "name": "assessment_result",
      "label": "Статус оценивания",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": true,
      "description": "laim-assessment-result.v1 из laim-asessor-agent",
      "order": 2
    },
    {
      "name": "in",
      "label": "входные данные",
      "in": true,
      "type": "default",
      "shape": "shape_model",
      "required": false,
      "dynamic": true,
      "description": "Результаты тестов с семафором (km, drift, oos-oot)",
      "order": 3
    },
    {
      "name": "all_results",
      "label": "all_results",
      "in": false,
      "type": "default",
      "shape": "shape_model",
      "description": "monitoring-result/v2: итоговый цвет, assessment_result и реестр test_results",
      "order": 4
    }
  ],
  "portsMetadata": {
    "hasDynamicInputPort": true,
    "hasDynamicOutputPort": false
  },
  "script": {
    "type": "python",
    "deployType": "docker",
    "baseImageKey": "py312-simple",
    "runConfiguration": {
      "libraryDependencies": [
        "requirements.txt"
      ],
      "sourceFiles": [
        "main.py",
        "aggregator.py"
      ],
      "functionName": "main",
      "functionParameters": []
    }
  },
  "ui": {
    "settings": [
      {
        "page": "General",
        "title": "General",
        "components": [
          {
            "type": "form",
            "label": "Порог автоассесора",
            "config": {
              "components": [
                {
                  "parameter": "red_assessor_accuracy",
                  "label": "Минимальная точность автоассесора",
                  "uiComponent": "input",
                  "type": "float",
                  "defaultValue": 0.6
                }
              ]
            }
          }
        ]
      }
    ],
    "result": {
      "title": "Results",
      "components": [
        {
          "type": "semaphore",
          "label": "Итоговый светофор мониторинга",
          "order": 1,
          "config": {
            "datasets": [
              {
                "value": "$.all_results.calculated_traffic_lights.test_light",
                "title": "$.all_results.calculated_traffic_lights.semaphore_title"
              }
            ]
          },
          "showOnWorkflow": true
        },
        {
          "type": "html",
          "uiComponent": "html",
          "name": "$.all_results.report_html",
          "parameter": "$.all_results.report_html",
          "label": "Сводка агрегации",
          "order": 2,
          "config": {
            "datasets": [
              {
                "data": "$.all_results.report_html"
              }
            ]
          }
        }
      ]
    }
  }
}
